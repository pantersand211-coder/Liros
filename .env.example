# Offentlig site-URL (canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://liros.ai

# Aktiv bookingadresse (HubSpot-mødeside). SKAL bekræftes af ejeren. Gæt ikke en medarbejder.
# Tom = ingen indlejret kalender; siden viser kun forespørgselsformularen.
NEXT_PUBLIC_BOOKING_URL=

# Selvbetjent prøveflow i den eksisterende app
NEXT_PUBLIC_TRIAL_URL=https://liros.ai/try
# Login til appen (vises kun hvis sat)
NEXT_PUBLIC_APP_LOGIN_URL=

# Base for eksisterende sider, der ikke er genbygget her (om os, blog, vilkår, ...)
NEXT_PUBLIC_LEGACY_BASE=https://liros.ai

# Lead-transport: "file" (kun udvikling, skriver .data/leads.jsonl) | "webhook" | "none"
# Uden gyldig transport svarer API'et 503 og siden viser IKKE succes.
LEAD_TRANSPORT=file
# Kun ved webhook (server-side hemmeligheder, aldrig i frontend):
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Vis ikke-verificerede integrationsnavne som UDKAST (kun til intern review)
SHOW_UNVERIFIED_INTEGRATIONS=0
